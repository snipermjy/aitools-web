# ==========================================
# AI工具导航站 - 环境变量配置模板
# ==========================================
# 说明：
# 1. 复制此文件为 .env.local (前端) 或 .env (后台)
# 2. 填写实际的配置值
# 3. 不要将包含真实密钥的 .env 文件提交到 Git
# ==========================================

# ------------------------------------------
# Supabase 数据库配置
# ------------------------------------------
# Supabase 项目 URL（公开）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase 匿名密钥（公开，用于前端）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase 服务端密钥（私密，仅用于后台，不要暴露给前端）
SUPABASE_SERVICE_KEY=your-service-role-key

# ------------------------------------------
# Cloudflare R2 存储配置
# ------------------------------------------
# R2 账户 ID
R2_ACCOUNT_ID=your-r2-account-id

# R2 Access Key ID
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# R2 存储桶名称
R2_BUCKET_NAME=your-bucket-name

# R2 公开 URL（用于访问图片）
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-r2-bucket.com

# R2 自定义域名（可选）
NEXT_PUBLIC_R2_CUSTOM_DOMAIN=

# ------------------------------------------
# 硅基流动 DeepSeek API 配置
# ------------------------------------------
# API Key
DEEPSEEK_API_KEY=your-deepseek-api-key

# API Base URL（默认为硅基流动的地址）
DEEPSEEK_API_BASE_URL=https://api.siliconflow.cn/v1

# 使用的模型名称
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------
# 后台管理系统配置
# ------------------------------------------
# 管理员用户名
ADMIN_USERNAME=admin

# 管理员密码（首次登录后请修改）
ADMIN_PASSWORD=change_this_password_123

# JWT 密钥（用于生成登录令牌）
JWT_SECRET=your-random-jwt-secret-key-at-least-32-characters

# Session 密钥
SESSION_SECRET=your-random-session-secret-key

# ------------------------------------------
# 站点配置
# ------------------------------------------
# 站点 URL（生产环境域名）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 站点名称
NEXT_PUBLIC_SITE_NAME=AI工具导航

# ------------------------------------------
# 分析统计配置（可选）
# ------------------------------------------
# Google Analytics ID (GA4)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# 百度统计 ID
NEXT_PUBLIC_BAIDU_ANALYTICS_ID=

# ------------------------------------------
# Next.js 配置
# ------------------------------------------
# 运行端口（前端默认 3000，后台建议 3001）
PORT=3000

# Node 环境
NODE_ENV=development

# ------------------------------------------
# 其他配置
# ------------------------------------------
# 是否启用调试模式
DEBUG=false

# API 请求超时时间（毫秒）
API_TIMEOUT=30000

# 缓存时长（秒）
CACHE_DURATION=3600

